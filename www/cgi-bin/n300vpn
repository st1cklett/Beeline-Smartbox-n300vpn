io.write('<dialog id="path-dialog"><form method="post" id="path-form"><input type="hidden" name="token" value="', html(token), '"><input type="hidden" name="action" value="set-paths"><div class="dialog-body"><div class="dialog-title">Настройка VPN</div><div class="sub">Отмеченные подключения используют VPN. Остальные выходят напрямую через основной роутер.</div><div class="path-list">')
local path_labels = {lan1="LAN1", lan2="LAN2", lan3="LAN3", lan4="LAN4", wifi="Wi-Fi"}
for _, path in ipairs({"lan1", "lan2", "lan3", "lan4", "wifi"}) do
    local value = status["path_" .. path] or "off|unknown|||0"
    local selected = value:match("^on|") ~= nil
    io.write('<label class="path-row"><input type="checkbox" name="path_', path, '" value="1"', selected and ' checked' or '', '><span><strong>', path_labels[path], '</strong></span><span class="path-state" data-path-state="', path, '">Проверяю…</span></label>')
end
io.write('</div><div class="note">WAN аппаратно исключён и не может быть выбран. Изменение применяется к новым соединениям; активные загрузки могут завершиться по прежнему пути.</div><div class="dialog-actions"><button type="button" class="secondary" data-close-dialog="path-dialog">Отмена</button><button type="submit" data-pending="Применение…">Сохранить</button></div></div></form></dialog>')

