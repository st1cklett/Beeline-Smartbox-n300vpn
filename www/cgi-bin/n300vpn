io.write('<div class="message', action_ok and '' or ' error', '" id="message" role="status" aria-live="polite"', message == "" and ' hidden' or '', '>', html(message), '</div>')
io.write('<section class="status" id="status">')
local labels = {mode="VPN",active="Выбранный сервер",engine="VPN-процесс",routes="Трафик через VPN",watchdog="Автовосстановление",updating="Обновление списка",selected="Доступных серверов",autostart="После перезагрузки"}
for _, key in ipairs({"mode","active","engine","routes","watchdog","updating","selected","autostart"}) do
