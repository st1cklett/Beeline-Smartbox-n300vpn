io.write('<section class="server-group" id="repository-section"><div class="section-head"><div><div><span class="source-badge repository">Репозиторий</span></div><h2>Доступные серверы</h2><p class="section-description">Проверенные серверы из репозитория igareck.</p></div><span class="count-badge" id="repository-count">', html(#repository_nodes), '</span></div><div class="nodes" id="repository-nodes">')
