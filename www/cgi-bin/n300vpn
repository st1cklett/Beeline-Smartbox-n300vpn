#!/usr/bin/lua

local root = "/mnt/usb/n300vpn"
local control = root .. "/bin/n300vpn-control.sh"
local subscription_path = root .. "/private/subscription.url"

local function read_file(path)
    local file = io.open(path, "rb")
    if not file then return "" end
    local value = file:read("*a") or ""
    file:close()
    return value:gsub("%s+$", "")
end

local function html(text)
    return tostring(text or ""):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"):gsub("'", "&#39;")
end

local function json(text)
    return '"' .. tostring(text or ""):gsub("\\", "\\\\"):gsub('"', '\\"'):gsub("\b", "\\b"):gsub("\f", "\\f"):gsub("\n", "\\n"):gsub("\r", "\\r"):gsub("\t", "\\t"):gsub("[%z\001-\031]", "") .. '"'
end

local function decode(text)
    text = (text or ""):gsub("+", " ")
    return text:gsub("%%(%x%x)", function(hex) return string.char(tonumber(hex, 16)) end)
end

local function parse_form(text)
    local values = {}
    for item in (text or ""):gmatch("[^&]+") do
        local key, value = item:match("^([^=]+)=?(.*)$")
        if key then values[decode(key)] = decode(value) end
    end
    return values
end

local function split_tsv(line)
    local fields = {}
    local start = 1
    while true do
        local position = line:find("\t", start, true)
        if not position then
            fields[#fields + 1] = line:sub(start)
            break
        end
        fields[#fields + 1] = line:sub(start, position - 1)
        start = position + 1
    end
    return fields
end

local function run(arguments)
    local command = control
    for _, value in ipairs(arguments) do command = command .. " '" .. value .. "'" end
    command = command .. " 2>&1; result=$?; echo __N300VPN_EXIT__=$result"
    local pipe = io.popen(command, "r")
    if not pipe then return "Не удалось запустить команду", false end
    local output = pipe:read("*a") or ""
    pipe:close()
    local exit_text = output:match("__N300VPN_EXIT__=(%d+)%s*$")
    local ok = exit_text == "0"
    output = output:gsub("%s*__N300VPN_EXIT__=%d+%s*$", "")
    output = output:gsub("%s+$", "")
    return output ~= "" and output or (ok and "Готово" or "Команда завершилась с ошибкой"), ok and true or false
end

local function read_values(path)
    local values = {}
    local file = io.open(path, "rb")
    if not file then return values end
    for line in file:lines() do
        local key, value = line:gsub("\r$", ""):match("^([%w_]+)=(.*)$")
        if key then values[key] = value end
    end
    file:close()
    return values
end

local function save_subscription_url(value)
    value = tostring(value or ""):gsub("^%s+", ""):gsub("%s+$", "")
    local prefix = "https://crunch-crunch.com/sub/"
    if #value < #prefix + 16 or #value > 2048 or value:sub(1, #prefix) ~= prefix then
        return false, "Эта ссылка не похожа на поддерживаемую подписку Crunch."
    end
    local token_part = value:sub(#prefix + 1)
    if not token_part:match("^[%w%._~%-]+$") then
        return false, "В ссылке подписки обнаружены недопустимые символы."
    end
    os.execute("mkdir -p /mnt/usb/n300vpn/private")
    local temporary = subscription_path .. ".new"
    local file = io.open(temporary, "wb")
    if not file then return false, "Не удалось сохранить подписку на USB-накопитель." end
    file:write(value, "\n")
    file:close()
    os.execute("chmod 600 /mnt/usb/n300vpn/private/subscription.url.new")
    if not os.rename(temporary, subscription_path) then
        os.remove(temporary)
        return false, "Не удалось безопасно применить подписку."
    end
    os.remove(root .. "/private/crunch.url")
    return true, "Подписка сохранена."
end

local function load_state()
    local status_output = run({"status"})
    local status = {}
    for line in status_output:gmatch("[^\r\n]+") do
        local key, value = line:match("^([%w_]+)=(.*)$")
        if key then status[key] = value end
    end
    local stats = read_values(root .. "/state/import.stats")
    local youtube = {}
    local youtube_file = io.open(root .. "/state/youtube-results.tsv", "rb")
    if youtube_file then
        for line in youtube_file:lines() do
            local fields = split_tsv(line:gsub("\r$", ""))
            if #fields >= 4 then
                youtube[fields[2]] = {score=fields[1], page=fields[3], media=fields[4], endpoint=fields[5] or ""}
            end
        end
        youtube_file:close()
    end
    local youtube_best = read_file(root .. "/state/youtube-best.id")
    local nodes = {}
    local selected = io.open(root .. "/state/selected.tsv", "rb")
    if selected then
        for line in selected:lines() do
            local fields = split_tsv(line:gsub("\r$", ""))
            if #fields >= 8 then
                local source = fields[9] or (fields[3]:match("^Crunch%-VPN%-") and "crunch" or "repository")
                local check = youtube[fields[2]] or {}
                nodes[#nodes + 1] = {latency=fields[1], id=fields[2], label=fields[3], protocol=fields[4], server=fields[5], port=fields[6], transport=fields[7], security=fields[8], source=source, youtube_score=check.score or "", youtube_page=check.page or "", youtube_media=check.media or "", youtube_best=fields[2] == youtube_best}
            end
        end
        selected:close()
    end
    return status, stats, nodes
end

local method = os.getenv("REQUEST_METHOD") or "GET"
local query = parse_form(os.getenv("QUERY_STRING") or "")
local form = {}
if method == "POST" then
    local length = tonumber(os.getenv("CONTENT_LENGTH") or "0") or 0
    if length > 0 and length <= 4096 then form = parse_form(io.read(length)) end
end

local token = read_file(root .. "/state/web.token")
local message = ""
local action_ok = true
if method == "POST" then
    if token == "" or form.token ~= token then
        message = "Защитный токен неверен; обновите страницу."
        action_ok = false
    elseif form.action == "enable" and form.id and form.id:match("^vless%-%x%x%x%x%x%x%x%x$") then
        message, action_ok = run({"enable", form.id})
    elseif form.action == "confirm" then
        message, action_ok = run({"confirm"})
    elseif form.action == "disable" then
        message, action_ok = run({"disable"})
    elseif form.action == "probe" and form.id and form.id:match("^vless%-%x%x%x%x%x%x%x%x$") then
        message, action_ok = run({"probe", form.id})
    elseif form.action == "youtube" and form.id and form.id:match("^vless%-%x%x%x%x%x%x%x%x$") then
        message, action_ok = run({"youtube", form.id})
    elseif form.action == "rank-youtube" and (form.source == "crunch" or form.source == "repository") then
        message, action_ok = run({"rank-youtube", form.source})
    elseif form.action == "rank-youtube" then
        message = "Выберите источник серверов для проверки YouTube."
        action_ok = false
    elseif form.action == "add-subscription" then
        local saved, save_message = save_subscription_url(form.url)
        if saved then
            message, action_ok = run({"refresh"})
        else
            message, action_ok = save_message, false
        end
    elseif form.action == "delete-subscription" then
        message, action_ok = run({"remove-subscription"})
    elseif form.action == "set-paths" then
        local requested = {}
        for _, path in ipairs({"lan1", "lan2", "lan3", "lan4", "wifi"}) do
            if form["path_" .. path] == "1" then requested[#requested + 1] = path end
        end
        message, action_ok = run({"set-paths", table.concat(requested, ",")})
    elseif form.action == "refresh" then
        message, action_ok = run({"refresh"})
    else
        message = "Неизвестное действие."
        action_ok = false
    end
end

if not action_ok then
    if message:find("already running", 1, true) or message:find("still running", 1, true) then
        message = "Проверка серверов уже идёт. Дождитесь её завершения — прогресс показан на странице."
    elseif message:find("no reachable servers", 1, true) then
        message = "Пока нет доступных серверов. Сначала обновите подписку."
    elseif message:find("no_working_nodes", 1, true) then
        message = "Среди проверенных серверов не найдено подходящего для YouTube."
    elseif message:find("selected node failed", 1, true) then
        message = "Сервер перестал отвечать. Выберите другой сервер и повторите подключение."
    elseif message:find("handshake failed", 1, true) or message:find("response header read failed", 1, true) then
        message = "Этот сервер доступен, но не смог открыть YouTube. Попробуйте другой или запустите автоматический выбор лучших серверов."
    elseif message:find("disable VPN before removing subscription", 1, true) then
        message = "Перед удалением подписки выключите VPN, чтобы текущие устройства не потеряли соединение."
    end
end

local status, stats, nodes = load_state()
local subscription_present = read_file(subscription_path) ~= ""
local source_counts = {crunch=0, repository=0}
for _, node in ipairs(nodes) do
    if node.source ~= "crunch" or subscription_present then
        source_counts[node.source] = (source_counts[node.source] or 0) + 1
    end
end

local function display_status(key, value)
    local values = {
        mode = {off="Выключен", on="Включен", pending="Проверка подключения", ["local"]="Локальная проверка"},
        active = {none="Не выбран"},
        engine = {stopped="Остановлен", running="Работает"},
        routes = {off="Не используется", on="Используется"},
        watchdog = {stopped="Остановлено", running="Работает"},
        updating = {no="Нет", yes="Идёт"}
    }
    if key == "active" and value and value ~= "none" then
        for _, node in ipairs(nodes) do
            if node.id == value then return node.label end
        end
    end
    return (values[key] and values[key][value]) or value or "Неизвестно"
end
local wants_json = query.api == "status" or form.api == "1" or (os.getenv("HTTP_ACCEPT") or ""):find("application/json", 1, true)

local function write_json_state()
    io.write("Content-Type: application/json; charset=utf-8\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\n\r\n")
    io.write('{"ok":', action_ok and "true" or "false", ',"message":', json(message), ',"status":{')
    local first = true
    for _, key in ipairs({"mode", "active", "engine", "routes", "watchdog", "updating", "ranking", "selected", "autostart", "pending", "youtube_best", "youtube_best_score", "youtube_best_latency", "youtube_testing", "youtube_done", "youtube_total", "youtube_source", "scan_phase", "scan_testing", "scan_done", "scan_total"}) do
        if not first then io.write(",") end
        first = false
        io.write(json(key), ":", json(status[key] or "?"))
    end
    io.write('},"stats":{')
    first = true
    for _, key in ipairs({"total_vless", "unique_compatible", "reality", "vision", "grpc", "xhttp", "probe_candidates", "scanned", "reachable"}) do
        if not first then io.write(",") end
        first = false
        io.write(json(key), ":", json(stats[key] or "0"))
    end
    io.write('},"subscription":{"present":', subscription_present and "true" or "false", '},"paths":[')
    local path_labels = {lan1="LAN1", lan2="LAN2", lan3="LAN3", lan4="LAN4", wifi="Wi-Fi"}
    for index, path in ipairs({"lan1", "lan2", "lan3", "lan4", "wifi"}) do
        if index > 1 then io.write(",") end
        local value = status["path_" .. path] or "off|unknown|||0"
        local fields = {}
        for field in (value .. "|"):gmatch("([^|]*)|") do fields[#fields + 1] = field end
        io.write('{"id":', json(path), ',"label":', json(path_labels[path]),
                 ',"selected":', fields[1] == "on" and "true" or "false",
                 ',"link":', json(fields[2] or "unknown"), ',"speed":', json(fields[3] or ""),
                 ',"duplex":', json(fields[4] or ""), ',"devices":', json(fields[5] or "0"), "}")
    end
    io.write('],"nodes":[')
    for index, node in ipairs(nodes) do
        if index > 1 then io.write(",") end
        io.write('{"latency":', json(node.latency), ',"id":', json(node.id), ',"label":', json(node.label), ',"protocol":', json(node.protocol), ',"server":', json(node.server), ',"port":', json(node.port), ',"transport":', json(node.transport), ',"security":', json(node.security), ',"source":', json(node.source), ',"youtube_score":', json(node.youtube_score), ',"youtube_page":', json(node.youtube_page), ',"youtube_media":', json(node.youtube_media), ',"youtube_latency":', json(node.youtube_score), ',"youtube_best":', node.youtube_best and "true" or "false", "}")
    end
    io.write("]}")
end

if wants_json then
    write_json_state()
    os.exit(0)
end

local subscription_nodes, repository_nodes, youtube_nodes = {}, {}, {}
for _, node in ipairs(nodes) do
    if node.source == "crunch" then
        if subscription_present then subscription_nodes[#subscription_nodes + 1] = node end
    else
        repository_nodes[#repository_nodes + 1] = node
    end
    if node.youtube_score ~= "" then youtube_nodes[#youtube_nodes + 1] = node end
end
table.sort(youtube_nodes, function(left, right)
    local left_score, right_score = tonumber(left.youtube_score) or 999999, tonumber(right.youtube_score) or 999999
    if left_score == right_score then return (tonumber(left.latency) or 999999) < (tonumber(right.latency) or 999999) end
    return left_score < right_score
end)

local function ping_class(value)
    value = tonumber(value) or 999999
    if value <= 120 then return "ping-good", "хороший отклик" end
    if value <= 300 then return "ping-medium", "средний отклик" end
    return "ping-slow", "высокий отклик"
end

local function startup_class(value)
    value = tonumber(value) or 999999
    if value <= 1000 then return "ping-good" end
    if value <= 2000 then return "ping-medium" end
    return "ping-slow"
end

local function write_node(node, best_result)
    local class = "node"
    if node.id == status.active then class = class .. " active" end
    if best_result then class = class .. " best-result" end
    local ping_style, ping_text = ping_class(node.latency)
    local source_style = node.source == "crunch" and "subscription" or "repository"
    local source_label = node.source == "crunch" and "Моя подписка" or "Репозиторий"
    io.write('<article class="', class, '" data-node-id="', html(node.id), '"><div class="node-details"><div class="name">', html(node.label))
    if node.youtube_best then io.write(' <span class="winner-badge">№1 для YouTube</span>') end
    io.write('</div><div class="meta"><span class="source-badge ', source_style, '">', source_label, '</span><span>Отклик <span class="ping-badge ', ping_style, '" title="', ping_text, '">', html(node.latency), ' мс</span></span><span>', html(node.protocol:upper()), ' · ', html(node.transport), '/', html(node.security), '</span><span>', html(node.server), ':', html(node.port), '</span>')
    if node.youtube_score ~= "" then
        io.write('<span>YouTube: страница <span class="ping-badge ', startup_class(node.youtube_page), '" title="Холодное открытие страницы через новый VPN-туннель">', html(node.youtube_page), ' мс</span></span>')
        io.write('<span>видеосеть <span class="ping-badge ', startup_class(node.youtube_media), '" title="Холодная проверка доступности Googlevideo через новый VPN-туннель">', html(node.youtube_media), ' мс</span></span>')
    end
    io.write('</div></div><div class="actions">')
    io.write('<form method="post"><input type="hidden" name="token" value="', html(token), '"><input type="hidden" name="id" value="', html(node.id), '"><button name="action" value="enable" data-pending="Подключение…"', node.id == status.active and ' data-connected="yes" disabled' or '', '>', node.id == status.active and 'Подключено' or 'Подключить', '</button></form>')
    io.write('<form method="post"><input type="hidden" name="token" value="', html(token), '"><input type="hidden" name="id" value="', html(node.id), '"><button class="secondary" name="action" value="youtube" data-pending="Проверка YouTube…">Проверить YouTube</button></form>')
    io.write('<form method="post"><input type="hidden" name="token" value="', html(token), '"><input type="hidden" name="id" value="', html(node.id), '"><button class="secondary" name="action" value="probe" data-pending="Проверка…">Проверить сеть</button></form></div></article>')
end

